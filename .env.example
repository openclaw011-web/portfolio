# ── Headless CMS integration ─────────────────────────────
# The portfolio ships with bundled content (src/content/*.json) so it works
# with zero configuration. To manage content through a headless CMS, point
# VITE_CMS_URL at any endpoint serving { "en": Content, "ne": Content }.
#
# Sanity example:
#   VITE_CMS_URL=https://<project-id>.api.sanity.io/v2021-10-21/data/query/<dataset>?query=*[_type=="portfolio"]{en,ne}
#
# Contentful (delivery API) via a small edge function, or any JSON endpoint.
VITE_CMS_URL=
